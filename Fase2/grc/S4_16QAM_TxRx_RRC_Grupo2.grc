  id: variable
  parameters:
    comment: ''
    value: span*Sps+1
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1070.0
    - 8.0
    rotation: 0
    state: enabled
- name: rrc_base
  id: variable
  parameters:
    comment: ''
    value: firdes.root_raised_cosine(1.0, samp_rate, Rs, beta, ntaps)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8.0
    - 130.0
    rotation: 0
    state: enabled
- name: h_tx
  id: variable
  parameters:
    comment: 'RRC Tx: energia Sps (misma potencia que el pulso rectangular)'
    value: (numpy.array(rrc_base)*math.sqrt(Sps)/numpy.linalg.norm(rrc_base)).tolist()
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 260.0
    - 130.0
    rotation: 0
    state: enabled
- name: h_rx
  id: variable
  parameters:
    comment: 'RRC Rx (filtro acoplado): sum(h_tx*h_rx)=1'
    value: (numpy.array(rrc_base)/(math.sqrt(Sps)*numpy.linalg.norm(rrc_base))).tolist()
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 520.0
    - 130.0
    rotation: 0
    state: enabled
- name: const_obj
  id: variable
  parameters:
    comment: Constelacion de decision (misma tabla, sin normalizar de nuevo)
    value: digital.constellation_calcdist(list(tabla_de_verdad_constelacion), list(range(M)), 4, 1, digital.constellation.NO_NORMALIZATION).base()
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1840.0
    - 110.0
    rotation: 0
    state: enabled
